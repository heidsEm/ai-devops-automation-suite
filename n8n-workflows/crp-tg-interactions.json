    {
      "parameters": {
        "jsCode": "// Normalizes Telegram callback_query and force-reply message shapes.\nconst item = $input.first().json;\nlet kind = 'ignore', action = 'ignore', assetId = '', reason = '';\nlet userId = '', userName = 'user', messageId = '', chatId = '', callbackQueryId = '', originalText = '';\n\nif (item.callback_query) {\n  const cq = item.callback_query;\n  kind = 'callback';\n  callbackQueryId = cq.id;\n  userId = String(cq.from?.id || '');\n  userName = cq.from?.username || cq.from?.first_name || 'user';\n  messageId = String(cq.message?.message_id || '');\n  chatId = cq.message?.chat?.id || '';\n  originalText = cq.message?.text || cq.message?.caption || '';\n  const parts = String(cq.data || '').split(':');\n  action = parts[0] || '';\n  assetId = parts[1] || '';\n} else if (item.message && item.message.reply_to_message) {\n  const msg = item.message;\n  kind = 'message';\n  userId = String(msg.from?.id || '');\n  userName = msg.from?.username || msg.from?.first_name || 'user';\n  messageId = String(msg.reply_to_message.message_id || '');\n  chatId = msg.chat?.id || '';\n  reason = msg.text || '';\n  action = 'reject_reason';\n}\n\nreturn [{ json: { kind, action, assetId, reason, userId, userName, messageId, chatId, callbackQueryId, originalText } }];"
      },
